generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  name          String
  password      String
  role          String
  department    String
  salary        Float          @default(0.0)
  status        String         @default("ACTIVE")
  avatar        String?
  address       String?
  dob           String?
  exp           String?
  designation   String?
  mobile        String?
  lastSalary    Float?         @default(0.0)
  dateOfJoining String?
  passportPhoto String?
  aadharCard    String?
  panCard       String?
  marksheet10   String?
  marksheet12   String?
  graduation    String?
  otherDoc      String?
  works         String?
  createdAt     DateTime       @default(now())
  attendance    Attendance[]
  leaveRequests LeaveRequest[]
  assignedTasks Task[]         @relation("AssignedTasks")
  createdTasks  Task[]         @relation("CreatedTasks")
  callRecords   CallRecord[]
}

model Attendance {
  id        Int       @id @default(autoincrement())
  userId    Int
  clockIn   DateTime
  clockOut  DateTime?
  status    String
  date      String
  location  String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LeaveRequest {
  id        Int      @id @default(autoincrement())
  userId    Int
  startDate String
  endDate   String
  reason    String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Task {
  id            Int      @id @default(autoincrement())
  title         String
  description   String?
  status        String   @default("TODO")
  assignedToId  Int
  createdById   Int
  dueDate       String?
  createdAt     DateTime @default(now())
  priority      String   @default("Normal")
  reason        String?
  workSampleUrl String?
  assignedTo    User     @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: Cascade)
  createdBy     User     @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: Cascade)
}

model AuditLog {
  id              Int      @id @default(autoincrement())
  action          String
  performedByName String
  performedByRole String
  createdAt       DateTime @default(now())
}

model Client {
  id             Int              @id @default(autoincrement())
  clientId       String           @unique
  businessName   String
  clientName     String?
  joiningDate    String
  services       String
  packageName    String
  packageAmount  Float
  contact        String?
  email          String?
  password       String?
  website        String?
  sector         String?
  requirement    String?
  accountReady   Boolean          @default(false)
  active         Boolean          @default(true)
  extensionDays       Int              @default(0)
  extensionExpiryDate String?
  notes               String?
  createdAt           DateTime         @default(now())
  ClientDelivery      ClientDelivery[]
  ClientTask          ClientTask[]
  ClientFeedback      ClientFeedback[]
  RenewalRequest      RenewalRequest[]
}

model ClientDelivery {
  id           Int      @id @default(autoincrement())
  deliveryId   String   @unique
  clientId     String
  clientName   String
  postType     String
  postDate     String
  status       String   @default("Pending")
  linkedTaskId String?
  workingOn    String?
  notes        String?
  createdAt    DateTime @default(now())
  Client       Client   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
}

model ClientTask {
  id            Int      @id @default(autoincrement())
  taskId        String   @unique
  clientId      String
  businessName  String
  taskTitle     String
  date          String
  assignTo      String?
  workingOn     String?
  status        String   @default("Not Started")
  service       String?
  packageName   String?
  postType      String?
  notes         String?
  createdAt     DateTime @default(now())
  priority      String   @default("Normal")
  reason        String?
  workSampleUrl   String?
  statusChangedAt DateTime?
  Client          Client   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
}

model Plan {
  id           Int      @id @default(autoincrement())
  category     String
  name         String
  price        Float
  billingCycle String?
  features     Json
  createdAt    DateTime @default(now())
}

model ClientFeedback {
  id           Int      @id @default(autoincrement())
  clientId     String
  businessName String
  clientName   String?
  type         String   // "Feedback" or "Concern"
  rating       Int?     // Optional 1-5 rating
  message      String
  status       String   @default("Pending") // "Pending", "Reviewed"
  createdAt    DateTime @default(now())
  Client       Client   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
}

model CallRecord {
  id                  Int      @id @default(autoincrement())
  clientName          String
  phoneNumber         String
  status              String   @default("PENDING")
  notes               String?
  callDate            DateTime @default(now())
  followUpDate        DateTime?
  expectedValue       Float?
  leadSource          String?
  salesPersonId       Int
  packageName         String?  // Service package sold: "Meta Ads", "Google Ads", "Website Design", "Combo Package"
  expectedClosingDate DateTime? // When client is expected to pay / onboard after conversion
  salesPerson         User     @relation(fields: [salesPersonId], references: [id], onDelete: Cascade)
}

model RenewalRequest {
  id              Int      @id @default(autoincrement())
  clientId        String
  clientDbId      Int
  businessName    String
  requestType     String   // "RENEWAL" or "EXTENSION"
  status          String   @default("PENDING") // "PENDING", "APPROVED", "REJECTED"
  requestedDays   Int?     // For extension: 1 to 7 days (requested by TL)
  approvedDays    Int?     // For extension: 1 to 10 days (approved by Admin)
  reason          String?  // TL notes/reason
  adminNote       String?  // Admin review notes
  requestedById   Int
  requestedByName String
  requestedByRole String   @default("TL")
  approvedById    Int?
  approvedByName  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  client          Client   @relation(fields: [clientDbId], references: [id], onDelete: Cascade)
}
